{
  "name": "dsh-lan-memory",
  "version": "2.2.0",
  "description": "Local-first memory & persona plugin for DeepSeek Harness (DSH): three-layer file memory, SOUL/MOOD persona, zero-LLM capture, BM25 recall, local web panel, themed mood card. 澜·轻量本地记忆与人格系统。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "persona",
    "soul",
    "mood",
    "local-first",
    "markdown",
    "bm25",
    "ai-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiefeng/dsh-lan-memory.git"
  },
  "homepage": "https://github.com/kiefeng/dsh-lan-memory#readme",
  "bugs": {
    "url": "https://github.com/kiefeng/dsh-lan-memory/issues"
  },
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "ui",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/",
    "dev": "node scripts/dev-server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
